{
  "name": "pleiades",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"wrangler dev\" \"turbo run dev\"",
    "build": "turbo run build",
    "deploy": "wrangler deploy",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260828.1",
    "@tailwindcss/postcss": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.14",
    "prettier": "latest",
    "tailwindcss": "^4.3.0",
    "turbo": "latest",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11",
    "wrangler": "4.124.0"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.21.0",
    "ai": "^7.0.79",
    "pdf-lib": "^1.17.1",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.15.0",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.4.3"
  }
}
