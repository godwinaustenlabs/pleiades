/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pleiades",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-03",
	"observability": {
		"enabled": true
	},
	// Every var here is read by the Worker. VERBOSE, AGENT_ID and CF_ACCOUNT_ID
	// used to sit alongside these and were read by nothing — see the note on the
	// Env type in src/index.ts for why that went unnoticed for so long.
	"vars": {
		// One AI Gateway per agent. Shared would mean one request log mixing payroll
		// runs with "what's on my calendar", which is a log nobody reads.
		"AI_GATEWAY_ACCOUNTANT": "pleiades-accounting-agent",
		"AI_GATEWAY_SLACK": "pleiades-slack-agent",
		// Must match `name` below: the cron path has no inbound request to take an
		// origin from, and this is what stops a preview deploy calling production.
		"WORKER_ORIGIN": "https://pleiades.galabs.workers.dev",
		"LLM_MODEL": "@cf/openai/gpt-oss-120b"
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./apps/web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	// The accountant's twice-daily check: 06:00 and 17:00 UTC, which is 11am and
	// 10pm in Pakistan — the start of the working day and after it ends. Cron
	// rather than the Agents SDK's this.schedule() because the run is global,
	// not per-conversation, and no Durable Object here wakes on a timer.
	"triggers": {
		"crons": [
			"0 6 * * *",
			"0 17 * * *"
		]
	},
	// The Worker bound to itself. Agent tools call back into this Worker's own
	// API so a tool request traverses exactly the same middleware chain
	// (authMiddleware -> requireAppAccess -> requireFeatureAccess) as a browser
	// request. A service binding dispatches in-process, so it does not leave the
	// edge, does not depend on public DNS, and works under `wrangler dev` and in
	// tests, where a loopback fetch to the Worker's own origin hangs.
	"services": [
		{
			"binding": "SELF",
			"service": "pleiades"
		}
	],
	// The Slack agent runs as a Durable Object via the Agents SDK: one instance
	// per Slack conversation, so turns in a thread are serialised and the
	// conversation keeps its own durable SQLite state.
	"durable_objects": {
		"bindings": [
			{
				"name": "SLACK_AGENT",
				"class_name": "SlackAgent"
			},
			{
				"name": "ACCOUNTANT_AGENT",
				"class_name": "AccountantAgent"
			}
		]
	},
	// SQLite-backed Durable Objects must be declared here or the class has no
	// storage and `this.sql` throws at runtime.
	// A brand-new script starts its DO migration history at v1. The old office
	// script's v1/v2 tags are not carried across: tags are per-script, and this
	// script has never had a Durable Object before.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"SlackAgent",
				"AccountantAgent"
			]
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "f075010c-d41b-4c3e-b859-9981b3e7aad1",
			"database_name": "pleiades-db",
			"migrations_dir": "packages/database/migrations"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"r2_buckets": [
		{
			"binding": "CRM_BUCKET",
			"bucket_name": "pleiades-docs"
		},
		{
			// Source documents for the accountant's knowledge base. Kept apart
			// from CRM_BUCKET so a compliance manual can never be served through
			// /api/assets, which is reachable by anyone with the right grant.
			"binding": "COMPLIANCE_BUCKET",
			"bucket_name": "pleiades-compliance-docs"
		}
	],
	// Retrieval over those documents. Rates never come from here — see
	// src/agents/pleiades-accountant/knowledge.ts.
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "pleiades-compliance"
		}
	]
}