{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "office",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-03",
	"observability": {
		"enabled": true
	},
	"vars": {
		"VERBOSE": "true",
		// "LLM_MODEL": "llama-3.3-70b-versatile",
		"LLM_MODEL": "gemini-2.5-flash",
		"CLIENT_ID": "user-001",
		"AGENT_ID": "nova-mcp-agent",
		"CF_ACCOUNT_ID": "ec758d282b2c89b4a1a147b64f445849",
		"CF_GATEWAY_NAME": "testing-gateway",
		"CF_AIG_TOKEN": "O2bUj1gkZwFjlrW4HnXz_d1tMxWbbT8UMBJFfHqA",
		"OPENAI_API_KEY": "REPLACE_ME_OPENAI_KEY",
		"GROQ_API_KEY": "REPLACE_ME_GROQ_KEY",
		"GEMINI_API_KEY": "REPLACE_ME_GEMINI_KEY",
		"API_KEY_SECRET": "ganova_api_key_secret_2026",
		"SLACK_CLIENT_SECRET": "fddd398cb4a868c56749dd5be6f396f5",
		"SLACK_CLIENT_ID": "4833348314737.11182995222051",
		"SLACK_SIGNING_SECRET": "cf46c5dab2e807ef77126bdb7714a78f",
		"SLACK_BOT_OAUTH_TOKEN": "xoxb-4833348314737-11173953481207-wJ06Q8rsKJNxZ1F7n2aUGfBe",
		"SLACK_VERIFICATION_TOKEN": "uUX1sJb0a76KKL2EvegUSaNW",
		"SYSTEM_PROMPT": "You are a helpful AI assistant with access to professional tools via MCP. Use them to help the user."
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./apps/web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "2c0c6471-7fcb-4ce0-96fa-03a41d260201",
			"database_name": "office-db",
			"migrations_dir": "packages/database/migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CLIENTS_KV_NAMESPACE",
			"id": "669b10984a084d2d88f046a056d2ad4d"
		},
		{
			"binding": "MEMORY_KV_NAMESPACE",
			"id": "fe850a4d50b945ab84298100d85e9460"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"r2_buckets": [
		{
			"binding": "CRM_BUCKET",
			"bucket_name": "office-crm-docs"
		}
	]
}